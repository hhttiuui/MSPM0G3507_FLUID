# ============================================================
#  MSPM0G3507 流体模拟工程 —— 忽略规则
#
#  原则：只忽略“能重新生成”和“本机特有”的东西。
#  Debug/ 下的构建脚本（makefile、subdir_vars.mk、device.opt、
#  device_linker.cmd、ti_msp_dl_config.c/.h 等）必须保留，
#  否则别人 clone 下来无法直接 gmake 构建。
# ============================================================

# ---------- 编译产物（可重新生成）----------
Debug/**/*.o
Debug/**/*.d
Debug/**/*.d_raw
Debug/*.map
Debug/*.out
Debug/*.lst

# ---------- SysConfig / 链接器中间输出 ----------
Debug/Event.dot
Debug/*_linkInfo.xml

# ---------- IDE / 语言服务器缓存 ----------
# 旧仓库里 580 个跟踪文件中有 371 个是这个 clangd 索引缓存
Debug/.clangd/
Debug/.cache/
.settings/

# ---------- 编辑器 / 系统垃圾 ----------
Thumbs.db
Desktop.ini
*.swp
*~

# ---------- 不属于本工程的遗留数据 ----------
# test_results/ 是电机 PID / 开环 PWM 那套工程的实测记录，
# 与流体模拟无关，已在 d318ce6 从仓库删除。这条规则防止再被误加回来。
test_results/

# ---------- 备份与残留（协作流程手册 4.5 节）----------
*.bak
*.bak-*
*.orig
README.html

# ---------- 构建产物补充 ----------
# firmware.hex 每次编译都会重新生成，内容随代码变，提交进来只会误导别人
Debug/*.hex

# ---------- 语言服务器自动生成的配置 ----------
# .clangd 文件头自己写着 "do not add it to source-control"
.clangd
